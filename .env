# PostgreSQL - Orders
ORDER_DB_HOST=orders-db
ORDER_DB_PORT=5432
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres
ORDER_DB_NAME=orders_db

# PostgreSQL - Payments
PAYMENT_DB_HOST=payments-db
PAYMENT_DB_PORT=5432
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASSWORD=postgres
PAYMENT_DB_NAME=payments_db

# RabbitMQ
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_ADDR=redis:6379

# Order Service
HTTP_PORT=8080
GRPC_PORT=9090
PAYMENT_SERVICE_GRPC_ADDR=payment-service:9091
PAYMENT_TIMEOUT_SECS=5
CACHE_TTL_SECS=300
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECS=60

# Notification Service
PROVIDER_MODE=SIMULATED
MAX_RETRIES=3

# Real Email (used when PROVIDER_MODE=REAL)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword
SMTP_FROM=your@email.com
